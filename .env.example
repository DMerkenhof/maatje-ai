# Kopieer dit bestand naar .env en vul minstens je OpenRouter-key in.

# Je OpenRouter API-key (openrouter.ai/keys). Niet nodig als je alleen lokale modellen gebruikt.
OPENROUTER_API_KEY=

# Inloggen. Laat je beide leeg, dan maakt de app bij de eerste start zelf een wachtwoord
# en zet dat in de logs: docker compose logs | grep Wachtwoord
APP_PASSWORD=
# Alleen op "off" zetten als de app niet vanaf internet of je thuisnetwerk bereikbaar is
# (bijvoorbeeld alleen via Tailscale op je eigen apparaten).
AUTH=

# Optioneel: model dat een nieuwe chat standaard krijgt, bijv. de id uit de modelkiezer.
# Leeg laten mag; de app onthoudt het laatst gekozen model.
DEFAULT_MODEL=

# Optioneel: vaste instructie die elk gesprek meekrijgt.
SYSTEM_PROMPT=

# Optioneel: lokale modellen op je eigen computer (Ollama).
# Bijv. http://100.x.y.z:11434 (Tailscale-IP) of http://192.168.1.20:11434 (thuisnetwerk).
LOCAL_BASE_URL=
# Hoe de app die computer noemt ("je Mac", "je pc").
LOCAL_NAME=Mac
# Hoeveel tekst een lokaal model in één keer kan overzien (tokens). Lager = minder geheugengebruik.
LOCAL_NUM_CTX=32768

# Optioneel: model dat na elk gesprek de memory bijwerkt, bijv. local/qwen3:8b of een
# OpenRouter-model. Leeg = het model waarmee je het laatst chatte. Ook te wijzigen in de app.
MEMORY_MODEL=
